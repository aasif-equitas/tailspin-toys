---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <button
          type="button"
          class="self-start rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-blue-400 hover:text-blue-300 focus:ring-2 focus:ring-blue-500 focus:outline-none sm:self-auto"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>

      <form class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/50 p-5 md:grid-cols-[1fr_16rem]" data-testid="game-filters">
        <fieldset>
          <legend class="mb-3 text-sm font-medium text-slate-200">Filter by category</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition hover:border-blue-400 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                <input
                  type="checkbox"
                  value={category.id}
                  class="accent-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                {category.name}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="flex flex-col gap-3 text-sm font-medium text-slate-200" for="publisher-filter">
          Publisher
          <select
            id="publisher-filter"
            class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </label>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match those filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  function applyFilters(): void {
    if (!filterForm || !grid || !emptyState) return;

    const selectedCategories = new Set(
      [...filterForm.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map(
        (input) => input.value,
      ),
    );
    const publisher = filterForm.querySelector<HTMLSelectElement>('select')?.value ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = publisher === '' || card.dataset.publisherId === publisher;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      visibleCount += visible ? 1 : 0;
    }

    grid.hidden = visibleCount === 0;
    emptyState.classList.toggle('hidden', visibleCount !== 0);
  }

  filterForm?.addEventListener('change', applyFilters);
  clearFilters?.addEventListener('click', () => {
    filterForm?.reset();
    applyFilters();
  });
</script>
